# Интервал автообновления стакана, в секундах.
NEXT_PUBLIC_ORDERBOOK_REFRESH_SECONDS=300

# Глубина стакана (кол-во уровней bid/ask, которые запрашиваем у биржи).
# Допустимые значения у Binance: 5, 10, 20, 50, 100, 500, 1000, 5000.
# ВАЖНО: 5000 доступно только на споте. У фьючерсов (fapi) максимум — 1000,
# запрос с 5000 вернёт ошибку -1130. Код сам подбирает максимум под market,
# если значение здесь не подходит для конкретного рынка.
# Дальше сырые уровни группируются на фронте по шагу цены (см. lib/aggregate.ts).
ORDERBOOK_DEPTH_LIMIT=5000

